{
  "name": "lumen-world-trends",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.json && vite build && vite build --config electron/vite.config.ts && node scripts/copy-preload.mjs",
    "test": "vitest run",
    "build:main": "vite build --config electron/vite.config.ts && node scripts/copy-preload.mjs",
    "capture:shots": "npm run build && cross-env LUMEN_CAPTURE=1 electron ."
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "echarts": "^6.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rss-parser": "^3.13.0",
    "sql.js": "^1.11.0"
  }
}
